# Copy to .env.local for local development. On Hostinger, set these in
# Website Dashboard → Environment variables instead.

# MySQL database (optional). Leave unset to run with in-memory stores.
# Either a single URL...
# DATABASE_URL=mysql://u123456789_justeg:password@localhost:3306/u123456789_justeg
# ...or the separate variables Hostinger's own guide uses:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Secret used to hash client addresses for rate limiting, so raw IPs are
# never stored. Generate with: openssl rand -hex 32
RATE_LIMIT_SECRET=
